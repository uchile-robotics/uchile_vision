<!--
	Sample launch file for depthimage_to_laserscan
	As of September 2nd 2021.
-->

<launch>

  <!-- Depthimage whitout INPAINTING 
  <node name="depthimage_to_laserscan_1" pkg="depthimage_to_laserscan" type="depthimage_to_laserscan" args="">

    <remap from="image"       to="/camera/depth/image_rect_raw"/>
    <remap from="camera_info" to="/camera/depth/camera_info"/> 
    <remap from="scan" to="/depth_image_to_laserscan_1/scan1"/> 
    <param name="min_scan_height" type="double" value="0.06"/>
    <param name="max_scan_height" type="double" value="0.7"/>
    <param name="camerasensor_frame_id" type="str" value="camera_depth_optical_frame"/>
    <param name="scan_frame_id" type="str" value="camera_link"/>
    <param name="output_frame_id" type="str" value="camera_link"/>
  </node>	 -->


    <!-- Depth Image whit INPAINTING-->
  <node name="depthimage_to_laserscan_2" pkg="depthimage_to_laserscan" type="depthimage_to_laserscan" args="">

    <remap from="image"       to="/camera/depth_inpainted/image_rect_raw"/>
    <remap from="camera_info" to="/camera/depth_inpainted/camera_info"/> 
    <remap from="scan" to="/depth_image_to_laserscan_2/scan2"/> 
    <!-- the remap for camera_info by default uses the same path as the one given to the image topic. Default: "<path_to_image_topic>/camera_info>" -->
    <param name="min_scan_height" type="double" value="0.06"/>
    <param name="max_scan_height" type="double" value="0.7"/>
    <param name="camerasensor_frame_id" type="str" value="camera_depth_optical_frame"/>
    <param name="scan_frame_id" type="str" value="camera_link"/>
    <param name="output_frame_id" type="str" value="camera_link"/>
  </node>	
</launch>